# Blog da Dra. Karen Moraes — variáveis necessárias
# Copie os valores reais para .env.local (nunca commitar .env.local)

# Token do GitHub (fine-grained, restrito ao repositório) — ver seção 11
# de app/proposta-comercial/karenmoraes/proposta-blog-google-docs.md
KARENMORAES_GITHUB_OWNER=
KARENMORAES_GITHUB_REPO=
KARENMORAES_GITHUB_BRANCH=main
KARENMORAES_GITHUB_TOKEN=

# Login da área de admin: NUNCA a senha em texto puro, só o hash bcrypt.
# Gerar com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# ATENÇÃO: o Next.js expande "$" em arquivos .env (estilo variável de shell).
# Escape todo "$" do hash como "\$", senão o valor chega corrompido em runtime.
# Exemplo: $2b$10$abc... vira \$2b\$10\$abc...
KARENMORAES_ADMIN_PASSWORD_HASH=

# String aleatória usada para assinar a sessão (JWT).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KARENMORAES_SESSION_SECRET=
